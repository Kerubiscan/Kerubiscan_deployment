# ==========================================
# KSA KERUBISOC - PRODUCTION ENVIRONMENT CONFIG
# ==========================================
# Copy this file to `.env` in the root directory before running `docker compose up -d`

# Database Configuration
POSTGRES_DB=ksadb
POSTGRES_USER=ksauser
POSTGRES_PASSWORD=change_this_to_a_secure_password_123

# MinIO Object Storage Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_this_minio_secret_key_123
MINIO_BUCKET_NAME=ksa-storage

# Backend Security & JWT Config
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_long_change_me!
CERTIFICATE_SIGNING_SECRET=super_secret_certificate_signing_key_change_me!
CERTIFICATE_VERIFICATION_BASE_URL=http://localhost:9006

# Frontend & CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:9005
NEXT_PUBLIC_API_URL=http://localhost:9006

# Initial Admin User Credentials
KSA_BOOTSTRAP_ADMIN_EMAIL=admin@ksa.org
KSA_BOOTSTRAP_ADMIN_PASSWORD=Admin123Pass!
