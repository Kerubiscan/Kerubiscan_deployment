# Server / Host Deployment Settings
# Host IP Address: 192.168.1.253

# Frontend URL (accessible by user browser)
NEXTAUTH_URL="http://192.168.1.253:9443"

# Keycloak Public URL (accessible by user browser)
KEYCLOAK_PUBLIC_URL="http://192.168.1.253:1990"
KEYCLOAK_ISSUER="http://192.168.1.253:1990/realms/kimia"

# Docker Internal Service URLs (Container-to-Container - DO NOT CHANGE)
KEYCLOAK_INTERNAL_URL="http://192.168.1.253:1990"
BACKEND_API_URL="http://api:8000"

# Keycloak Realm & Client Credentials
KEYCLOAK_REALM="kimia"
KEYCLOAK_CLIENT_ID="kerubiscan-web"
KEYCLOAK_CLIENT_SECRET="kerubiscan-web-secret"
NEXTAUTH_SECRET="super-secret-key-for-kerubiscan-nextauth"
