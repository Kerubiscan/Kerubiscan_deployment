# Server / Host Deployment Settings
# (No need to configure host IPs anymore; Kerubiscan dynamically detects it!)

# Keycloak Realm & Client Credentials (Frontend)
KEYCLOAK_REALM="kimia"
FRONTEND_KEYCLOAK_CLIENT_ID="kerubiscan-web"
FRONTEND_KEYCLOAK_CLIENT_SECRET="kerubiscan-web-secret"
NEXTAUTH_SECRET="super-secret-key-for-kerubiscan-nextauth"

# API Settings
PROJECT_NAME="Kimia Vulnerability Scanner"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
POSTGRES_URL="postgresql://kimia:kimia_password@db:5432/kimia_db"

# Redis
REDIS_URL="redis://redis:6379/0"

# Keycloak Authentication (Backend)
KEYCLOAK_REALM_NAME="kimia"
BACKEND_KEYCLOAK_CLIENT_ID="kimia-backend"
BACKEND_KEYCLOAK_CLIENT_SECRET="kimia-backend-secret"

# AI Engine Configuration
AI_PROVIDER="ollama"
AI_MODEL="gemini-1.5-flash"
GEMINI_API_KEY=""
AI_ENDPOINT="http://192.168.1.56:11434/api/chat"
