# Server / Host Deployment Settings
# Ce fichier est un TEMPLATE. Le .env final est genere par install.sh (ou install.ps1).
#
# ADRESSE IP : la plateforme ne depend plus de l'IP du serveur. Le portail et Keycloak sont
# adresses avec l'adresse que le navigateur utilise (en-tete Host) : un changement d'IP
# (pont -> NAT, DHCP, nouvelle VM) ne demande ni nouveau .env ni nouveau build.
# Ne renseigner NEXTAUTH_URL / KEYCLOAK_PUBLIC_URL que pour une adresse publique FIXE
# (nom de domaine, HTTPS derriere un proxy) ; vides, elles suivent l'adresse du navigateur.

# Keycloak Realm & Client Credentials (Frontend)
KEYCLOAK_REALM="kimia"
FRONTEND_KEYCLOAK_CLIENT_ID="KVS-web"
FRONTEND_KEYCLOAK_CLIENT_SECRET="KVS-web-secret"
NEXTAUTH_SECRET="super-secret-key-for-KVS-nextauth"
NEXTAUTH_URL=""
KEYCLOAK_PUBLIC_URL=""

# API Settings
PROJECT_NAME="Kerubi Vulnerability Scanner"
VERSION="1.0.0"
API_V1_STR="/api/v1"
# Le frontend joint l'API par le reseau Docker interne (aucune IP). Lu au BUILD du frontend.
BACKEND_API_URL="http://api:8000"

# Database
POSTGRES_URL="postgresql://kimia:kimia_password@db:5432/kimia_db"

# Redis
REDIS_URL="redis://redis:6379/0"

# Keycloak Authentication (Backend)
KEYCLOAK_REALM_NAME="kimia"
BACKEND_KEYCLOAK_CLIENT_ID="kimia-backend"
BACKEND_KEYCLOAK_CLIENT_SECRET="kimia-backend-secret"

# AI Engine Configuration
AI_PROVIDER="ollama"
AI_MODEL="gemini-1.5-flash"
GEMINI_API_KEY="your_api_key_here"
# Ollama sur la machine hote : joint par host.docker.internal (suit l'IP de l'hote)
AI_ENDPOINT="http://host.docker.internal:11434/api/chat"

# OpenVAS Configuration
# Nom affiche par l'interface web d'OpenVAS (port 9392) uniquement ; les scans ne l'utilisent pas.
OPENVAS_HOSTNAME="__HOST_IP__"
OPENVAS_PASSWORD="admin"
OPENVAS_SKIPSYNC="false"

# SMTP Configuration (Email Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Scan reliability / recette guardrails
# Scans run one at a time by default (ZAP/OpenVAS are memory-hungry). Raise with care.
SCAN_CONCURRENCY="1"
# Perimeter guard: if set, only these targets can be scanned (IP, CIDR, domain, *.sub.domain).
# Comma or space separated. Empty = no restriction. Strongly recommended in recette.
SCAN_ALLOWED_TARGETS=""
# An OpenVAS task stuck at the same progress for this long is stopped.
OPENVAS_STALL_HOURS="4"
# Data retention (0 = keep forever). Replaces the former purge on every API restart.
AUDIT_RETENTION_DAYS="90"
RAW_OUTPUT_RETENTION_DAYS="30"
