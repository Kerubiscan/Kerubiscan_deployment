# Server / Host Deployment Settings
# Ce fichier est un TEMPLATE. Le .env final est genere automatiquement
# par install.sh (ou install.ps1), qui detecte l'IP de la VM hote et la substitue partout.

# Keycloak Realm & Client Credentials (Frontend)
KEYCLOAK_REALM="kimia"
FRONTEND_KEYCLOAK_CLIENT_ID="KVS-web"
FRONTEND_KEYCLOAK_CLIENT_SECRET="KVS-web-secret"
NEXTAUTH_SECRET="super-secret-key-for-KVS-nextauth"
NEXTAUTH_URL="http://__HOST_IP__:9443"
KEYCLOAK_PUBLIC_URL="http://__HOST_IP__:1990"

# API Settings
PROJECT_NAME="Kerubi Vulnerability Scanner"
VERSION="1.0.0"
API_V1_STR="/api/v1"
BACKEND_API_URL="http://__HOST_IP__:9445"

# Database
POSTGRES_URL="postgresql://kimia:kimia_password@db:5432/kimia_db"

# Redis
REDIS_URL="redis://redis:6379/0"

# Keycloak Authentication (Backend)
KEYCLOAK_REALM_NAME="kimia"
BACKEND_KEYCLOAK_CLIENT_ID="kimia-backend"
BACKEND_KEYCLOAK_CLIENT_SECRET="kimia-backend-secret"

# AI Engine Configuration
AI_PROVIDER="ollama"
AI_MODEL="gemini-1.5-flash"
GEMINI_API_KEY="your_api_key_here"
AI_ENDPOINT="http://__HOST_IP__:11434/api/chat"

# OpenVAS Configuration
OPENVAS_HOSTNAME="__HOST_IP__"
OPENVAS_PASSWORD="admin"
OPENVAS_SKIPSYNC="false"

# SMTP Configuration (Email Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
